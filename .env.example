# Copy to .env and fill in — .env is gitignored, so deployment-specific
# values never end up in a commit.

# Container registry images are pushed to.
DO_REGISTRY=registry.digitalocean.com/your-registry

# Optional: DigitalOcean cluster name. When set, deploy.sh fetches its
# kubeconfig via doctl; leave unset to use your current kubectl context.
#DO_CLUSTER_NAME=your-cluster
